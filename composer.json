{
  "name": "searching/search",
  "description": "Smart Responsor Searching component for user-facing business-data search.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "symfony/config": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/console": "^8.1",
    "symfony/http-foundation": "^8.1",
    "symfony/messenger": "^8.1",
    "doctrine/orm": "^3.0",
    "doctrine/doctrine-bundle": "^3.0",
    "symfony/form": "^8.1",
    "doctrine/persistence": "^4.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
	"friendsofphp/php-cs-fixer": "3.94"
  },
  "autoload": {
    "psr-4": {
      "App\\Searching\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Searching\\Tests\\": "tests/"
    }
  },
  "extra": {
    "symfony": {
      "allow-contrib": false
    }
  }
}
