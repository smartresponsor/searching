{
  "name": "searching/search",
  "description": "Smart Responsor Searching component for user-facing business-data search.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "require": {
    "collectioning/collection": "dev-master",
    "cruding/crud": "dev-master",
    "easycorp/easyadmin-bundle": "^5.0",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "tabling/table": "dev-master",
    "viewing/view": "dev-master",
    "php": "^8.4",
    "symfony/framework-bundle": "^8.1",
    "symfony/config": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/console": "^8.1",
    "symfony/http-foundation": "^8.1",
    "symfony/messenger": "^8.1",
    "doctrine/orm": "^3.0",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "symfony/form": "^8.1",
    "doctrine/persistence": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Searching\\": "src/"
    }
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "bundle": "App\\Searching\\SearchingBundle"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
